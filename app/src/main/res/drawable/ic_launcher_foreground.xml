<?xml version="1.0" encoding="utf-8"?>
<!-- A QR finder-pattern trio plus a scan sweep. Drawn inside the 66dp adaptive-icon safe zone
     (the outer 18dp of the 108dp canvas can be masked away by the launcher). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- top-left finder -->
    <path android:fillColor="#FFC800"
        android:pathData="M30,30h18v18h-18z M25,25h28v28h-28z M29,29h20v20h-20z"
        android:fillType="evenOdd" />
    <!-- top-right finder -->
    <path android:fillColor="#FFC800"
        android:pathData="M60,30h18v18h-18z M55,25h28v28h-28z M59,29h20v20h-20z"
        android:fillType="evenOdd" />
    <!-- bottom-left finder -->
    <path android:fillColor="#FFC800"
        android:pathData="M30,60h18v18h-18z M25,55h28v28h-28z M29,59h20v20h-20z"
        android:fillType="evenOdd" />

    <!-- data speckle in the empty quadrant -->
    <path android:fillColor="#FFC800"
        android:pathData="M58,58h7v7h-7z M69,58h7v7h-7z M58,69h7v7h-7z M69,69h7v7h-7z" />
</vector>
